#!/usr/bin/env bash
set -Eeuo pipefail

store="$HOME/.local/bin/clipse-store-safe"
pids=()

stop_unsafe_listeners() {
    local proc pid i
    local -a args

    for proc in /proc/[0-9]*; do
        [[ -r "$proc/cmdline" ]] || continue
        args=()
        mapfile -d '' -t args < "$proc/cmdline" 2>/dev/null || continue
        ((${#args[@]})) || continue
        [[ "${args[0]##*/}" == "wl-paste" ]] || continue

        for ((i = 1; i + 2 < ${#args[@]}; i++)); do
            if [[ "${args[$i]}" == "--watch" \
                && "${args[$((i + 1))]##*/}" == "clipse" \
                && "${args[$((i + 2))]}" == "--wl-store" ]]; then
                pid="${proc##*/}"
                kill "$pid" >/dev/null 2>&1 || true
                break
            fi
        done
    done
}

cleanup() {
    trap - EXIT INT TERM
    if ((${#pids[@]})); then
        kill "${pids[@]}" >/dev/null 2>&1 || true
        wait "${pids[@]}" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap 'exit 0' INT TERM

# Clipse's stock autostart may leave detached listeners behind. They bypass the
# shared history lock, so remove them before starting the serialized pair.
stop_unsafe_listeners

wl-paste --type text --watch "$store" &
pids+=("$!")
wl-paste --type image/png --watch "$store" &
pids+=("$!")

wait -n "${pids[@]}"
