#!/usr/bin/env python3
"""Prépare le cache des fonds d'écran pour le studio Caelestia.

Pour chaque vidéo du dossier de fonds :
  - une affiche (1re image, à la hauteur de l'écran) ;
  - un mini-clip d'aperçu (270p, 6 s) pour le survol dans le studio ;
  - une copie à la hauteur de l'écran quand la source est plus grande (4K -> 1080p),
    lue par le shell à la place de l'original (≈4x moins de CPU) ;
  - ses métadonnées (taille, i/s, durée).
Les images n'ont besoin que de leurs métadonnées.

Tout est décrit dans index.json, que le shell surveille. Les originaux ne sont jamais modifiés.

Usage :
  caelestia-wallpaper-cache build [--async] [FICHIER...]
  caelestia-wallpaper-cache quality [auto|source]
  caelestia-wallpaper-cache playable FICHIER
  caelestia-wallpaper-cache status
"""

import argparse
import fcntl
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "caelestia" / "wallpaper-video"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "caelestia"
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "caelestia"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp")

QUALITY_FILE = CONFIG / "wallpaper-video-quality"
SHELL_JSON = CONFIG / "shell.json"
INDEX = CACHE / "index.json"
LOCK = RUNTIME / "caelestia-wallpaper-cache.lock"
RERUN = RUNTIME / "caelestia-wallpaper-cache.rerun"
LOG = STATE / "wallpaper-cache.log"

VIDEO_EXT = {".mp4", ".webm", ".mkv", ".mov", ".avi", ".m4v"}
IMAGE_EXT = {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif", ".tif", ".tiff", ".avif", ".jxl"}
PREVIEW_HEIGHT = 270
PREVIEW_SECONDS = 6
INDEX_VERSION = 2


def log(message: str) -> None:
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a", encoding="utf-8") as fh:
            fh.write(f"[{time.strftime('%F %T')}] {message}\n")
    except OSError:
        pass


def wallpaper_dir() -> Path:
    raw = ""
    try:
        raw = json.loads(SHELL_JSON.read_text(encoding="utf-8")).get("paths", {}).get("wallpaperDir", "")
    except (OSError, ValueError, AttributeError):
        pass
    raw = os.environ.get("CAELESTIA_WALLPAPERS_DIR") or raw or "~/Pictures/Wallpapers"
    return Path(os.path.expandvars(os.path.expanduser(raw)))


def target_height() -> int:
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3).stdout
        heights = [m["width"] if m.get("transform", 0) % 2 else m["height"] for m in json.loads(out)]
        if heights:
            return max(int(h) for h in heights)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        pass
    return 1080


def quality() -> str:
    try:
        return "source" if QUALITY_FILE.read_text().strip() == "source" else "auto"
    except OSError:
        return "auto"


def key_for(path: Path) -> str:
    # Même clé que l'ancien caelestia-wallpaper-video : les copies déjà encodées sont réutilisées.
    return hashlib.sha1(str(path).encode()).hexdigest()[:20]


def kind_of(path: Path) -> str | None:
    suffix = path.suffix.lower()
    if suffix in VIDEO_EXT:
        return "video"
    if suffix in IMAGE_EXT:
        return "image"
    return None


def list_wallpapers(root: Path) -> list[Path]:
    if not root.is_dir():
        return []
    walls = []
    for dirpath, dirnames, filenames in os.walk(root, followlinks=True):
        dirnames[:] = sorted(d for d in dirnames if not d.startswith("."))
        for name in sorted(filenames):
            path = Path(dirpath) / name
            if not name.startswith(".") and kind_of(path) and path.is_file():
                walls.append(path)
    return walls


def fresh(output: Path, source: Path) -> bool:
    try:
        return output.stat().st_size > 0 and output.stat().st_mtime >= source.stat().st_mtime
    except OSError:
        return False


def run(cmd: list[str], timeout: float | None = None) -> bool:
    try:
        res = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as exc:
        log(f"échec {cmd[0]}: {exc}")
        return False
    if res.returncode != 0:
        log(f"échec {' '.join(cmd[:3])}…: {res.stderr.strip()[-400:]}")
        return False
    return True


def probe(path: Path) -> dict:
    """Métadonnées mises en cache (invalidées si la taille ou la date du fichier changent)."""
    st = path.stat()
    meta_file = CACHE / "meta" / f"{key_for(path)}.json"
    try:
        cached = json.loads(meta_file.read_text())
        if cached.get("mtime") == int(st.st_mtime) and cached.get("size") == st.st_size:
            return cached
    except (OSError, ValueError):
        pass

    meta = {"mtime": int(st.st_mtime), "size": st.st_size}
    try:
        out = subprocess.run(
            [
                "ffprobe", "-v", "error", "-select_streams", "v:0",
                "-show_entries", "stream=width,height,avg_frame_rate,r_frame_rate:format=duration",
                "-of", "json", str(path),
            ],
            capture_output=True, text=True, timeout=15,
        ).stdout
        data = json.loads(out)
        stream = (data.get("streams") or [{}])[0]
        meta["width"] = int(stream.get("width") or 0)
        meta["height"] = int(stream.get("height") or 0)
        if kind_of(path) == "video":
            for rate in (stream.get("avg_frame_rate"), stream.get("r_frame_rate")):
                if rate and "/" in rate:
                    num, den = rate.split("/", 1)
                    if float(den or 0) > 0 and float(num) > 0:
                        meta["fps"] = round(float(num) / float(den), 2)
                        break
            duration = (data.get("format") or {}).get("duration")
            if duration:
                meta["duration"] = round(float(duration), 2)
    except (OSError, ValueError, subprocess.SubprocessError):
        pass

    meta_file.parent.mkdir(parents=True, exist_ok=True)
    tmp = meta_file.with_suffix(".tmp")
    tmp.write_text(json.dumps(meta))
    tmp.replace(meta_file)
    return meta


def poster_path(path: Path, target: int) -> Path:
    return CACHE / "covers" / f"{target}p" / f"{key_for(path)}.jpg"


def copy_path(path: Path, target: int) -> Path:
    return CACHE / f"{target}p" / f"{key_for(path)}.mp4"


def preview_path(path: Path) -> Path:
    return CACHE / "preview" / f"{key_for(path)}.mp4"


def make_poster(src: Path, target: int) -> Path | None:
    out = poster_path(src, target)
    if fresh(out, src):
        return out
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_name(out.stem + ".tmp.jpg")
    ok = run(
        [
            "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-y", "-i", str(src),
            "-frames:v", "1", "-vf", f"scale=-2:'min({target},ih)':flags=lanczos", "-q:v", "2", str(tmp),
        ],
        timeout=30,
    )
    if ok and tmp.exists() and tmp.stat().st_size > 0:
        tmp.replace(out)
        return out
    tmp.unlink(missing_ok=True)
    return out if out.exists() else None


def make_copy(src: Path, target: int) -> Path | None:
    out = copy_path(src, target)
    if fresh(out, src):
        return out
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_name(out.stem + ".tmp.mp4")
    log(f"copie {target}p {src}")
    started = time.monotonic()
    # GPU NVIDIA d'abord, repli logiciel ensuite.
    ok = run(
        [
            "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-y",
            "-hwaccel", "cuda", "-hwaccel_output_format", "cuda", "-i", str(src),
            "-vf", f"scale_cuda=-2:{target}:interp_algo=lanczos",
            "-c:v", "h264_nvenc", "-preset", "p6", "-tune", "hq", "-rc", "vbr", "-cq", "19", "-b:v", "0",
            "-maxrate", "20M", "-bufsize", "40M", "-profile:v", "high",
            "-an", "-movflags", "+faststart", str(tmp),
        ]
    ) or run(
        [
            "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-y", "-i", str(src),
            "-vf", f"scale=-2:{target}:flags=lanczos", "-c:v", "libx264", "-preset", "medium", "-crf", "18",
            "-pix_fmt", "yuv420p", "-an", "-movflags", "+faststart", str(tmp),
        ]
    )
    if ok and tmp.exists() and tmp.stat().st_size > 0:
        tmp.replace(out)
        log(f"copie prête en {time.monotonic() - started:.1f}s : {out.name}")
        return out
    tmp.unlink(missing_ok=True)
    return None


def make_preview(src: Path, decode_from: Path) -> Path | None:
    out = preview_path(src)
    if fresh(out, src):
        return out
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_name(out.stem + ".tmp.mp4")
    vf = f"scale=-2:{PREVIEW_HEIGHT}:flags=bicubic,fps=30,format=yuv420p"
    base = ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-y", "-t", str(PREVIEW_SECONDS),
            "-i", str(decode_from), "-vf", vf, "-an", "-movflags", "+faststart"]
    ok = run(base + ["-c:v", "h264_nvenc", "-preset", "p5", "-rc", "vbr", "-cq", "30", "-b:v", "0", str(tmp)],
             timeout=120) or run(base + ["-c:v", "libx264", "-preset", "veryfast", "-crf", "30", str(tmp)], timeout=180)
    if ok and tmp.exists() and tmp.stat().st_size > 0:
        tmp.replace(out)
        return out
    tmp.unlink(missing_ok=True)
    return None


def entry_for(path: Path, target: int, mode: str) -> dict:
    kind = kind_of(path)
    try:
        meta = probe(path)
    except OSError:
        return {}
    entry = {"kind": kind}
    for k in ("width", "height", "fps", "duration", "size", "mtime"):
        if k in meta:
            entry[k] = meta[k]
    if kind == "video":
        poster = poster_path(path, target)
        if poster.exists():
            entry["poster"] = str(poster)
        preview = preview_path(path)
        if fresh(preview, path):
            entry["preview"] = str(preview)
        copy = copy_path(path, target)
        entry["playable"] = str(copy) if mode == "auto" and fresh(copy, path) else str(path)
        entry["optimised"] = entry["playable"] != str(path)
    return entry


def write_index(walls: list[Path], target: int) -> None:
    mode = quality()
    items = {}
    for path in walls:
        entry = entry_for(path, target, mode)
        if entry:
            items[str(path)] = entry
    data = {"version": INDEX_VERSION, "target": target, "quality": mode, "updated": int(time.time()), "items": items}
    try:
        old = json.loads(INDEX.read_text())
        if old.get("items") == items and old.get("quality") == mode:
            return  # Rien de nouveau : on évite de réveiller le shell.
    except (OSError, ValueError):
        pass
    INDEX.parent.mkdir(parents=True, exist_ok=True)
    tmp = INDEX.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=1))
    tmp.replace(INDEX)


def prune(videos: list[Path], target: int) -> None:
    keep = {key_for(p) for p in videos}
    keep_meta = keep | {key_for(p) for p in list_wallpapers(wallpaper_dir())}
    if not CACHE.is_dir():
        return
    for child in CACHE.iterdir():
        name = child.name
        if child.is_dir() and name.endswith("p") and name[:-1].isdigit() and name != f"{target}p":
            shutil.rmtree(child, ignore_errors=True)
            continue
        if not child.is_dir() or name not in {f"{target}p", "covers", "preview", "meta"}:
            continue
        for f in child.rglob("*"):
            if not f.is_file():
                continue
            stem = f.name.split(".", 1)[0]
            wanted = keep_meta if name == "meta" else keep
            if stem not in wanted or ".tmp." in f.name:
                f.unlink(missing_ok=True)
        if name == "covers":
            for d in child.iterdir():
                if d.is_dir() and d.name != f"{target}p":
                    shutil.rmtree(d, ignore_errors=True)


def build(files: list[str]) -> int:
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    lock = LOCK.open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        # Une construction tourne déjà : elle refera un tour à la fin.
        RERUN.touch()
        return 0

    try:
        os.nice(15)
    except OSError:
        pass

    while True:
        RERUN.unlink(missing_ok=True)
        target = target_height()
        walls = list_wallpapers(wallpaper_dir())
        todo = [Path(f).resolve() for f in files] if files else walls
        videos = [p for p in todo if kind_of(p) == "video" and p.is_file()]

        # 1. Métadonnées et affiches (rapide) : le studio est utilisable tout de suite.
        for path in todo:
            if path.is_file():
                probe(path)
        for path in videos:
            make_poster(path, target)
        write_index(walls, target)

        # 2. Aperçus de survol, puis copies écran (le plus long), en publiant l'index au fil de l'eau.
        for path in videos:
            copy = copy_path(path, target)
            make_preview(path, copy if fresh(copy, path) else path)
        write_index(walls, target)

        if quality() == "auto":
            for path in videos:
                meta = probe(path)
                if meta.get("height", 0) > target and not fresh(copy_path(path, target), path):
                    if make_copy(path, target):
                        write_index(walls, target)

        if not files:
            prune([p for p in walls if kind_of(p) == "video"], target)
        write_index(walls, target)

        if not RERUN.exists():
            break
        files = []
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Cache des fonds d'écran du studio Caelestia")
    sub = parser.add_subparsers(dest="cmd", required=True)
    p_build = sub.add_parser("build", help="prépare affiches, aperçus et copies écran")
    p_build.add_argument("--async", dest="detach", action="store_true", help="en arrière-plan")
    p_build.add_argument("files", nargs="*")
    p_quality = sub.add_parser("quality", help="lit ou change la qualité vidéo (auto|source)")
    p_quality.add_argument("value", nargs="?", choices=["auto", "source"])
    p_play = sub.add_parser("playable", help="fichier réellement lu pour un fond")
    p_play.add_argument("file")
    sub.add_parser("status", help="résumé du cache")
    args = parser.parse_args()

    if args.cmd == "build":
        if args.detach:
            LOG.parent.mkdir(parents=True, exist_ok=True)
            with open(os.devnull, "rb") as devnull, LOG.open("a") as out:
                subprocess.Popen([sys.executable, __file__, "build", *args.files], stdin=devnull, stdout=out,
                                 stderr=out, start_new_session=True)
            return 0
        return build(args.files)

    if args.cmd == "quality":
        if args.value:
            QUALITY_FILE.parent.mkdir(parents=True, exist_ok=True)
            QUALITY_FILE.write_text(args.value + "\n")
            write_index(list_wallpapers(wallpaper_dir()), target_height())
            if args.value == "auto":
                subprocess.Popen([sys.executable, __file__, "build"], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        print(quality())
        return 0

    if args.cmd == "playable":
        src = Path(args.file).resolve()
        copy = copy_path(src, target_height())
        print(copy if quality() == "auto" and fresh(copy, src) else src)
        return 0

    if args.cmd == "status":
        try:
            data = json.loads(INDEX.read_text())
        except (OSError, ValueError):
            print("index absent")
            return 1
        items = data.get("items", {})
        videos = [e for e in items.values() if e.get("kind") == "video"]
        print(f"fonds : {len(items)} (dont {len(videos)} vidéos), cible {data.get('target')}p, qualité {data.get('quality')}")
        print(f"copies écran : {sum(1 for e in videos if e.get('optimised'))}, aperçus : {sum(1 for e in videos if 'preview' in e)}")
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
