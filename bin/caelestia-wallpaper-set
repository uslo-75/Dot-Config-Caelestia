#!/usr/bin/env bash
# Change de wallpaper avec des fondus fluides :
#   image -> image : fondu + léger zoom dans le shell
#   * -> vidéo     : fondu vers la 1re image de la vidéo, mpvpaper charge en dessous, puis révélation
#   vidéo -> image : l'image apparaît en fondu par-dessus la vidéo, puis mpvpaper est arrêté
set -u

log="/tmp/caelestia-wallpaper-set.log"
exec >>"$log" 2>&1

wp="${1:-}"
wp="${wp//\\ / }"

[[ -z "$wp" || ! -e "$wp" ]] && exit 0

# Un seul changement à la fois ; un nouveau clic remplace celui en attente.
exec 8>"${XDG_RUNTIME_DIR:-/tmp}/caelestia-wallpaper-set.lock"
flock -w 6 8 || exit 0

config_file="$HOME/.config/waypaper/config.ini"
shell_config="$HOME/.config/caelestia/shell.json"
current_file="$HOME/.config/caelestia/waypaper-current"
video_helper="$HOME/.local/bin/caelestia-wallpaper-video"

mkdir -p "$HOME/.config/waypaper" "$HOME/.config/caelestia"

write_if_changed() {
    local file="$1"
    local value="$2"
    local current=""

    [[ -f "$file" ]] && current="$(cat "$file" 2>/dev/null || true)"
    if [[ "$current" != "$value" ]]; then
        printf '%s\n' "$value" > "$file"
    fi
}

is_animated() {
    case "${1,,}" in
        *.mp4|*.webm|*.mkv|*.mov|*.avi|*.m4v|*.gif) return 0 ;;
        *) return 1 ;;
    esac
}

# Le shell gère lui-même l'affichage image/vidéo : sa couche wallpaper reste toujours active.
ensure_shell_wallpaper_layer() {
    [[ -f "$shell_config" ]] || printf '{}\n' > "$shell_config"

    if jq -e '.background.enabled == true and .background.wallpaperEnabled == true' "$shell_config" >/dev/null 2>&1; then
        return 0
    fi

    local tmp
    tmp="$(mktemp)"
    if jq '.background.enabled = true | .background.wallpaperEnabled = true' "$shell_config" > "$tmp"; then
        mv "$tmp" "$shell_config"
    else
        rm -f "$tmp"
    fi
}

shell_ipc() {
    timeout 2 qs -c caelestia ipc call wallpaper "$@" 2>/dev/null
}

mpv_socket_paths() {
    find /tmp -maxdepth 1 -type s -name 'mpv-socket-*' -print 2>/dev/null | sort
}

mpv_get() {
    printf '{"command":["get_property","%s"]}\n' "$2" \
        | timeout 1 socat - "$1" 2>/dev/null \
        | jq -r 'select(.error == "success") | .data // empty' 2>/dev/null \
        | head -n 1
}

# Vrai quand mpvpaper joue réellement `desired` (quelques images déjà affichées).
mpv_playing() {
    local desired="$1" socket pos
    while IFS= read -r socket; do
        [[ -n "$socket" ]] || continue
        [[ "$(mpv_get "$socket" path)" == "$desired" ]] || continue
        pos="$(mpv_get "$socket" playback-time)"
        [[ -n "$pos" ]] && awk -v p="$pos" 'BEGIN { exit !(p > 0.05) }' && return 0
    done < <(mpv_socket_paths)
    return 1
}

wait_until() {
    local tries="$1"
    shift
    local i
    for ((i = 0; i < tries; i++)); do
        "$@" && return 0
        sleep 0.03
    done
    return 1
}

cover_ready() {
    [[ "$(shell_ipc coverReady)" == "true" ]]
}

apply_video_theme_async() {
    (
        "$HOME/.local/bin/caelestia-waypaper-apply" --theme-only "$1" >/dev/null 2>&1 || true
    ) &
}

update_waypaper_current() {
    python3 - "$wp" "$config_file" <<'PY'
import configparser
import sys
from pathlib import Path

home = Path.home()
wallpaper = sys.argv[1]
config_path = Path(sys.argv[2]).expanduser()
config_path.parent.mkdir(parents=True, exist_ok=True)

config = configparser.ConfigParser(interpolation=None)
config.optionxform = str
config.read(config_path)

if not config.has_section("Settings"):
    config.add_section("Settings")

defaults = {
    "language": "fr",
    "folder": "~/Images/wallpapers",
    "backend": "mpvpaper",
    "monitors": "All",
    "fill": "fill",
    "sort": "name",
    "color": "#111111",
    "subfolders": "True",
    "all_subfolders": "True",
    "show_hidden": "False",
    "show_gifs_only": "False",
    "show_path_in_tooltip": "True",
    "number_of_columns": "4",
    "use_xdg_state": "False",
    "zen_mode": "False",
    "mpvpaper_sound": "True",
    "mpvpaper_options": "--mute=yes --hwdec=auto-safe --profile=fast --cache=no --demuxer-max-bytes=32MiB --demuxer-max-back-bytes=8MiB --demuxer-readahead-secs=1 --vd-lavc-threads=2 --hwdec-extra-frames=1",
    "post_command": str(home / '.local/bin/caelestia-waypaper-apply') + ' --from-waypaper "$wallpaper"',
    "stylesheet": str(home / ".config/waypaper/style.css"),
    "keybindings": "~/.config/waypaper/keybindings.ini",
    "swww_transition_type": "none",
    "swww_transition_step": "63",
    "swww_transition_angle": "0",
    "swww_transition_duration": "0",
    "swww_transition_fps": "60",
}

for key, value in defaults.items():
    if not config.has_option("Settings", key):
        config.set("Settings", key, value)

config.set("Settings", "wallpaper", wallpaper)
config.set("Settings", "swww_transition_type", "none")
config.set("Settings", "swww_transition_duration", "0")

with config_path.open("w", encoding="utf-8") as fh:
    config.write(fh, space_around_delimiters=True)
PY
}


if is_animated "$wp"; then
    playable="$("$video_helper" playable "$wp")"
    cover="$("$video_helper" cover "$wp")"

    # 1. Fondu vers la première image de la nouvelle vidéo.
    covered=0
    if [[ -n "$cover" ]]; then
        shell_ipc transitionStart "$wp" "$cover" >/dev/null
        wait_until 40 cover_ready && covered=1
    fi

    # 2. Sous la couverture : on bascule le fond et on charge la vidéo.
    update_waypaper_current
    write_if_changed "$current_file" "$wp"
    ensure_shell_wallpaper_layer
    apply_video_theme_async "$wp"
    systemctl --user start mpvpaper-guard.service >/dev/null 2>&1 || true
    "$HOME/.local/bin/mpvpaper-guard" --sync >/dev/null 2>&1 || true

    # 3. Révélation dès que la vidéo tourne.
    wait_until 150 mpv_playing "$playable" || printf '[%s] mpvpaper lent pour %s\n' "$(date '+%F %T')" "$wp"
    shell_ipc transitionStop "$wp" >/dev/null
else
    had_video=0
    pgrep -x mpvpaper >/dev/null 2>&1 && had_video=1

    # Le shell affiche l'image en fondu (par-dessus la vidéo s'il y en avait une).
    update_waypaper_current
    write_if_changed "$current_file" "$wp"
    ensure_shell_wallpaper_layer

    if (( had_video )); then
        sleep 0.7
        pkill -x mpvpaper >/dev/null 2>&1 || true
        rm -f /tmp/mpv-socket-*
    fi

    "$HOME/.local/bin/caelestia-waypaper-apply" "$wp" >/dev/null 2>&1 || true
fi

exit 0
