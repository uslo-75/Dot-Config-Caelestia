#!/usr/bin/env bash
set -Eeuo pipefail

mode="${1:---archive}"
lock_held=0
[[ "${2:-}" == "--lock-held" ]] && lock_held=1

history="$HOME/.config/clipse/clipboard_history.json"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/clipse/history-backups"
lock="${XDG_RUNTIME_DIR:-/tmp}/clipse-history.lock"

[[ -s "$history" ]] || exit 0
jq -e '.clipboardHistory | type == "array"' "$history" >/dev/null 2>&1 || exit 1

if [[ "$lock_held" == "0" ]]; then
    exec 9>"$lock"
    flock -w 5 9 || exit 1
fi

mkdir -p "$state_dir"
chmod 700 "$state_dir"
tmp="$(mktemp "$state_dir/.clipboard-history.XXXXXX")"
cp -- "$history" "$tmp"
chmod 600 "$tmp"

if ! jq -e '.clipboardHistory | type == "array"' "$tmp" >/dev/null 2>&1; then
    rm -f -- "$tmp"
    exit 1
fi

case "$mode" in
    --last-good)
        mv -f -- "$tmp" "$state_dir/clipboard_history.last-good.json"
        ;;
    --archive)
        latest="$(find "$state_dir" -maxdepth 1 -type f -name 'clipboard_history.20*.json' -print 2>/dev/null | sort | tail -n 1)"
        if [[ -n "$latest" ]] && cmp -s "$tmp" "$latest"; then
            rm -f -- "$tmp"
            exit 0
        fi

        stamp="$(date '+%Y%m%d-%H%M%S-%N')"
        mv -- "$tmp" "$state_dir/clipboard_history.$stamp.json"

        mapfile -t archives < <(find "$state_dir" -maxdepth 1 -type f -name 'clipboard_history.20*.json' -print | sort)
        excess=$((${#archives[@]} - 72))
        if (( excess > 0 )); then
            for ((i = 0; i < excess; i++)); do
                rm -f -- "${archives[$i]}"
            done
        fi
        ;;
    *)
        rm -f -- "$tmp"
        printf 'Usage: %s [--archive|--last-good] [--lock-held]\n' "$0" >&2
        exit 2
        ;;
esac
