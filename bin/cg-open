#!/usr/bin/env bash
set -u

text_listener_pattern='[w]l-paste --type text --watch .*/clipse-store-safe'
image_listener_pattern='[w]l-paste --type image/png --watch .*/clipse-store-safe'
gui_pattern="(/usr/bin/clipse-gui|${HOME}/.local/bin/clipse-gui-fixed)( |$)"
gui_cmd="$HOME/.local/bin/clipse-gui-fixed"
lock="${XDG_RUNTIME_DIR:-/tmp}/cg-open.lock"

listener_ok() {
    pgrep -f "$text_listener_pattern" >/dev/null 2>&1 \
        && pgrep -f "$image_listener_pattern" >/dev/null 2>&1
}

stop_unsafe_listeners() {
    local proc pid i
    local -a args

    for proc in /proc/[0-9]*; do
        [[ -r "$proc/cmdline" ]] || continue
        args=()
        mapfile -d '' -t args < "$proc/cmdline" 2>/dev/null || continue
        ((${#args[@]})) || continue
        [[ "${args[0]##*/}" == "wl-paste" ]] || continue

        for ((i = 1; i + 2 < ${#args[@]}; i++)); do
            if [[ "${args[$i]}" == "--watch" \
                && "${args[$((i + 1))]##*/}" == "clipse" \
                && "${args[$((i + 2))]}" == "--wl-store" ]]; then
                pid="${proc##*/}"
                kill "$pid" >/dev/null 2>&1 || true
                break
            fi
        done
    done
}

ensure_listener() {
    stop_unsafe_listeners

    if listener_ok; then
        return 0
    fi

    systemctl --user restart clipse-listen-safe.service >/dev/null 2>&1 || true
    for _ in {1..20}; do
        listener_ok && return 0
        sleep 0.05
    done

    return 1
}

case "${1:-}" in
    --ensure-listener)
        ensure_listener
        exit 0
        ;;
    --status)
        if listener_ok; then
            listener_state=ok
        else
            listener_state=missing
        fi

        if pgrep -f "$gui_pattern" >/dev/null 2>&1; then
            gui_state=running
        else
            gui_state=stopped
        fi

        printf 'listener=%s\ngui=%s\n' "$listener_state" "$gui_state"
        exit 0
        ;;
esac

launch_gui() {
    "$HOME/.local/bin/clipse-history-snapshot" --archive >/dev/null 2>&1 || true

    if [ -x "$HOME/.local/bin/clipse-theme-sync" ]; then
        gtk_theme="$("$HOME/.local/bin/clipse-theme-sync" --gtk-theme 2>/dev/null || true)"
        if [ -n "${gtk_theme:-}" ]; then
            export GTK_THEME="$gtk_theme"
        fi
    fi

    if [ -x "$gui_cmd" ]; then
        "$gui_cmd" >/tmp/clipse-gui.log 2>&1 9>&- &
    else
        clipse-gui >/tmp/clipse-gui.log 2>&1 9>&- &
    fi
}

(
    flock -w 1 9 || exit 0

    if ! listener_ok; then
        ensure_listener
        if command -v notify-send >/dev/null 2>&1; then
            notify-send -a Clipse -t 1400 "Clipse" "Listener restarted" >/dev/null 2>&1 || true
        fi
    fi

    if pgrep -f "$gui_pattern" >/dev/null 2>&1; then
        if hyprctl clients 2>/dev/null | rg -iq 'class: .*clipse|title: .*Clipse'; then
            pkill -f "$gui_pattern" >/dev/null 2>&1 || true
        else
            pkill -f "$gui_pattern" >/dev/null 2>&1 || true
            sleep 0.08
            launch_gui
        fi
    else
        launch_gui
    fi
) 9>"$lock"
